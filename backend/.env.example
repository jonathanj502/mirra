# Supabase — Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# JWT verification needs no secret: tokens are ES256, verified against the public JWKS

# One OpenAI key for transcription, debrief coaching, and Reflect chat.
OPENAI_API_KEY=sk-...
OPENAI_DEBRIEF_MODEL=gpt-4.1
OPENAI_REFLECT_MODEL=gpt-4.1-mini
# Reflect includes transcript excerpts only when enabled in the user's settings.

# Stripe billing for Mirra Pro
# STRIPE_PRO_PRICE_ID should point at the $8/month recurring Price in Stripe.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_TRIAL_DAYS=14
STRIPE_SUCCESS_URL=http://127.0.0.1:8081/profile?checkout=success
STRIPE_CANCEL_URL=http://127.0.0.1:8081/profile?checkout=cancelled
STRIPE_PORTAL_RETURN_URL=http://127.0.0.1:8081/profile

# App config
FREE_TIER_CAP=5
CORS_ORIGINS=*    # comma-separated in prod, e.g. https://yourapp.com
