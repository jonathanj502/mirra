# Supabase — Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# JWT verification needs no secret: tokens are ES256, verified against the public JWKS

# One OpenAI key for transcription, debrief coaching, and Reflect chat.
OPENAI_API_KEY=sk-...
OPENAI_DEBRIEF_MODEL=gpt-4.1
OPENAI_REFLECT_MODEL=gpt-4.1-mini
# Reflect includes transcript excerpts only when enabled in the user's settings.

# App config
FREE_TIER_CAP=5
# Durable private recording volume, writable by the backend. One worker/instance only.
# Mount at least 32 GB in production; do not back up temporary audio or expose it as static files.
RECORDING_STORAGE_DIR=.recordings
CORS_ORIGINS=*    # comma-separated in prod, e.g. https://yourapp.com

# Set production to enforce HTTPS Supabase and explicit HTTPS CORS origins.
ENVIRONMENT=development
