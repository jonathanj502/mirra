{
  "expo": {
    "name": "Mirra",
    "slug": "mirra",
    "scheme": "mirra",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6EFE0",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ECE2D2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mirra.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Mirra uses your microphone to record conversations you choose to debrief.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "com.mirra.app",
      "adaptiveIcon": {
        "backgroundColor": "#ECE2D2"
      },
      "permissions": ["RECORD_AUDIO", "FOREGROUND_SERVICE", "FOREGROUND_SERVICE_MICROPHONE"]
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-web-browser"
    ]
  }
}
