{
  "expo": {
    "name": "Mirra",
    "slug": "mirra",
    "scheme": "mirra",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6EFE0",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mirra.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Record conversations with everyone’s permission. Mirra sends recordings to OpenAI to transcribe and provide coaching.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeAudioData",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.mirra.app",
      "adaptiveIcon": {
        "backgroundColor": "#B85136",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-web-browser",
      "./plugins/withRecordingService",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#F6EFE0"
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Record conversations with everyone’s permission. Mirra sends recordings to OpenAI to transcribe and provide coaching.",
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "extra": {
      "eas": {
        "projectId": "20253166-6402-4548-bb4a-5084bcc0dc03"
      }
    },
    "owner": "jjiang25"
  }
}
