{
  "expo": {
    "name": "Mirra",
    "slug": "mirra",
    "scheme": "mirra",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6EFE0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mirra.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Mirra uses your microphone to record conversations you choose to debrief.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.mirra.app",
      "adaptiveIcon": {
        "backgroundColor": "#ECE2D2"
      },
      "permissions": [
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#ECE2D2"
        }
      ],
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Mirra uses your microphone to record conversations you choose to debrief.",
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "20253166-6402-4548-bb4a-5084bcc0dc03"
      }
    },
    "owner": "jjiang25"
  }
}
